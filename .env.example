# Copy this file to .env and fill in what you have. Every value is optional:
# ChargeSight runs fully in simulation mode with an empty .env.
# NEVER commit your real .env (it is listed in .gitignore).

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///./data/chargesight.db   # default; PostgreSQL URLs also work

# --- Live simulator ---------------------------------------------------------
SIM_SEED=42
SIM_STEP_SECONDS=15
SIM_TICK_MS=1000
SIM_AUTOSTART=false

# --- Google Maps (browser key; restrict it by HTTP referrer, see docs/GOOGLE_MAPS.md)
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=

# --- Open Charge Map public listings (server-side key) ----------------------
OCM_API_KEY=

# --- Public charging-station listings for the Map page
# OpenStreetMap via Overpass (no key, ODbL). Refresh happens only when you press "Refresh listings".
OSM_ENABLED=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Google Places API (New): SERVER-SIDE key, different from the browser key. Results are shown live, never stored.
GOOGLE_PLACES_API_KEY=
# Load the bundled Open Charge Map snapshot of Bengaluru listings (CC BY 4.0) at start
PUBLIC_SNAPSHOT_AUTOLOAD=true

# --- Authorised operator REST API (server-side; never sent to the browser) -
OPERATOR_API_BASE_URL=
OPERATOR_API_KEY=
OPERATOR_API_TIMEOUT_S=10
OPERATOR_API_MAX_RETRIES=3
# 0 = manual 'Sync events' only; otherwise poll every N seconds (minimum 60)
OPERATOR_API_POLL_SECONDS=0
OPERATOR_API_STALE_AFTER_S=900

# --- Optional OCPP 1.6J central system (python -m app.integrations.ocpp_central)
OCPP_HOST=127.0.0.1
OCPP_PORT=9000

# --- Administrative override for the ticket workflow (leave empty to disable)
ADMIN_TOKEN=

# Build the SYNTHETIC demo dataset (6 h history, 8 tickets) on a new database
DEMO_AUTOSEED=true

# --- v9 accounts, sessions and SaaS (all optional; safe defaults) ----------
# ENVIRONMENT=development       # "production" forces Secure cookies, HSTS, hides /docs and disables the dev outbox
# COOKIE_SECURE=                # leave empty for automatic (Secure in production); set true when served over HTTPS
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=12
# SESSION_REMEMBER_DAYS=30
# PUBLIC_BASE_URL=http://127.0.0.1:8000   # used in links written to data/dev_outbox
# DEV_OUTBOX_ENABLED=true       # development only: verification / reset / invite messages are written to data/dev_outbox (never e-mailed)
# INTEGRATION_ENCRYPTION_KEY=   # Fernet key for stored operator credentials; if empty, data/keys/integration.key is created
# ALLOW_PRIVATE_INTEGRATION_HOSTS=false   # only for an administrator-controlled deployment on a private network
